# Firebase · Console → Project settings → General → Your apps → Web app → SDK setup and configuration
# Copy this file to .env.local (git-ignored) and fill in the values.
# These values are public by design (they ship in the browser bundle); access is
# protected by Authorized domains and Firebase Security Rules, not by secrecy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
